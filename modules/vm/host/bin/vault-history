#!/usr/bin/env bash
# vault-history: hourly "time machine" for the vault's text notes (job vault-history).
#
# Copies every text note (Markdown, HTML study pages, JSON, canvases, bases, scripts, CSV; no
# PDFs or images, files over 8 MB skipped) into ~/vault-history/tree and commits it to a local
# git repo. READ-ONLY for the vault. What it skips: ~/.config/uni-os/history-filters.txt
# (rclone filter file, generated by install-user.sh from vm.history_exclude: put private
# folders there). Browse with: uni-vm history [note], uni-vm grep, uni-vm find.
# Why: a recursive grep on the FUSE mount takes minutes (the copy answers in ~2 s), and the
# copy is a cheap undo when an agent damages a note.
# Source: the rclone remote itself in rclone-mount mode (Drive API listing, much faster than
# walking the mount), the vault folder in local mode.
# Usage: vault-history [--dry-run]
set -euo pipefail
HOST_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
. "$HOST_DIR/lib/common.sh"
DRY=""
if [ "${1:-}" = "--dry-run" ] || [ "${UNI_DRY_RUN:-0}" = 1 ]; then DRY=1; fi
H="${UNI_HISTORY_DIR:-$HOME/vault-history}"
FILTERS="$CONF_DIR/history-filters.txt"
if [ ! -f "$FILTERS" ]; then
  mkdir -p "$CONF_DIR"
  python3 "$HOST_DIR/lib/vaultconf.py" history-filters --vault "$VAULT" --uni-os "$UNI_OS_HOME" > "$FILTERS"
fi
if [ "$STORAGE_MODE" = rclone-mount ]; then
  SRC="$DRIVE_REMOTE:"; EXTRA=(--fast-list --drive-skip-gdocs)
else
  SRC="$VAULT"; EXTRA=()
fi
if [ -n "$DRY" ]; then
  echo "dry run: would sync $SRC -> $H/tree with $FILTERS and commit"; exit 0
fi
mkdir -p "$H/tree"
cd "$H"
if [ ! -d .git ]; then
  git init -q
  git config user.name "uni-os history"; git config user.email "uni-os@$(hostname)"
  printf '# Hourly history of the vault text notes (written by vault-history; a read-only copy)\n' > README.md
fi
rclone sync "$SRC" "$H/tree" "${EXTRA[@]}" --max-size 8M --filter-from "$FILTERS" --log-level ERROR
git add -A
if git diff --cached --quiet; then
  echo "no changes"
else
  n=$(git diff --cached --name-only | wc -l)
  git commit -q -m "vault $(date '+%a %d %b %Y %H:%M') ($n files)"
  echo "committed $n changed files"
fi
