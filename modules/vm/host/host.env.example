# Example of ~/.config/uni-os/host.env (fictional values for Alex Example). install-user.sh writes
# the real file: host-only values are asked once and kept, the rest comes from the vault config
# (_agent/uni-os.toml + module defaults) at every install. Your own changes go BELOW the
# "local overrides" marker (later lines win). Bash syntax. Never put secrets here.

# -- host-only values (asked at the first install, then kept) --
UNI_OS_HOME=/home/alex/uni-os    # framework copy on this host
UNI_OS_REPO_URL=''    # git URL to clone/pull the framework from; empty = laptop deploy
VAULT_MOUNT=/home/alex/Uni    # where the vault is on this host
VAULT_SENTINEL=_agent/agent-start.md    # file that proves the mount is real
STORAGE_MODE=rclone-mount    # rclone-mount | local
DRIVE_REMOTE=uni-drive    # rclone remote whose root is the vault folder
DRIVE_READ_ONLY=no    # yes = read-only mount (trial host)
RCLONE_ALLOW_OTHER=no    # yes = Windows may read the mount (WSL home server)
RCLONE_CACHE_MAX=6G    # rclone VFS cache size
AGENT_BIN=/home/alex/.local/bin/claude    # agent CLI binary
AGENT_PERMISSION_MODE=bypassPermissions    # permission mode for jobs, roles, RC
AGENT_HEADLESS_CMD=''    # other agents: headless command (prompt appended)
AGENT_INTERACTIVE_CMD=''    # other agents: interactive command (prompt appended)
AGENT_LOGIN_CHECK_CMD=''    # other agents: exit 0 while logged in
RC_ENABLED=yes    # yes = keep the Claude Code Remote Control server running
JOBS_LIVE=yes    # no = trial host, every job timer stays off
VAULT_WRITES=yes    # no = never write _agent/vm/* from this host (one writer)
LAPTOP_SEEN_MIN=15    # laptop ping younger than this = laptop online

# -- from the vault config (_agent/uni-os.toml + module defaults), refreshed by install-user.sh --
HOST_NAME=uni-vm    # vm.host_alias
HOST_KIND=gcp    # vm.provider
OWNER=Alex    # student.name
TZ_NAME=Europe/Zurich    # term.timezone
AGENT_CLI=claude    # agent.primary
AGENT_DEFAULT_MODEL=sonnet    # vm.default_model
AGENT_DEFAULT_EFFORT=high    # vm.default_effort
RC_NAME='Uni (VM)'    # vm.remote_control_name
RC_PREFIX=uni-vm    # vm.rc_prefix
RC_CAPACITY=10    # vm.rc_capacity
RC_CHROME=yes    # vm.rc_chrome
RC_UPDATE_HOUR=04    # vm.rc_update_hour
MACHINE_LABEL=e2-custom-small-4096    # vm.machine_type
BUDGET_MONTH=13    # vm.budget_month
BUDGET_CURRENCY=EUR    # vm.budget_currency
MONTHLY_CREDIT=0    # vm.monthly_credit
MEM_ALERT_MB=500    # vm.mem_alert_mb
MEM_CLOSE_JOBS_MB=700    # vm.mem_close_jobs_mb
SWAPIN_ALERT_RATE=250    # vm.swapin_alert_rate
DISK_ALERT_PCT=90    # vm.disk_alert_pct
ALERT_REPEAT_H=3    # vm.alert_repeat_h
BIG_CONTEXT_K=300    # vm.big_context_k
OUTCOME_PREP_GRACE_MIN=60    # vm.outcome_prep_grace_min
INBOX_STUCK_H=4    # vm.inbox_stuck_h|notify.inbox_stale_hours
TAP_STUCK_H=14    # vm.tap_stuck_h|notify.inbox_stale_hours_taps
GAP_OPEN_H=24    # heartbeat.gap_open_hours
OUTCOME_PREFIX='Outcome check: '    # heartbeat.outcome_prefix
AGENT_DIR=_agent    # paths.agent_dir
INBOX_DIR=inbox    # paths.inbox
DAILY_PREP_SLOTS='17:30, 19:30'    # schedule.daily_prep
MODULES_ENABLED='core, student-model, courses, planning, progress, daily-prep, notifications, roles, vm'    # modules.enabled
NOTIFY_PROVIDER=ntfy    # notify.provider
NTFY_TOPIC_FILE=/home/alex/.config/uni-os/ntfy-topic    # notify.ntfy_topic_file
NTFY_SERVER=https://ntfy.sh    # notify.ntfy_server

# --- local overrides (kept by install-user.sh; later lines win) ---
