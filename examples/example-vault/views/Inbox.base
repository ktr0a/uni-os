filters:
  and:
    - file.inFolder("inbox")
    - file.basename != "inbox"
properties:
  file.name:
    displayName: Unsorted item
  file.ext:
    displayName: Type
  file.ctime:
    displayName: Added
views:
  - type: table
    name: Inbox
    order:
      - file.name
      - file.ext
      - file.ctime
    sort:
      - property: file.ctime
        direction: ASC
