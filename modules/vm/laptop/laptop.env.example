# ~/.config/uni-os/laptop.env on the laptop (Windows: C:\Users\<you>\.config\uni-os\laptop.env).
# Read by modules/vm/laptop/vm.sh, deploy.sh (Git Bash), uni-vm.cmd and laptop-ping.ps1.
# One KEY="value" per line, comments on their own lines (uni-vm.cmd can't strip trailing comments).
# No secrets in here: the ssh key stays in ~/.ssh, the push topic on the host.

# The ssh alias of the host in ~/.ssh/config (INSTALL.md, "SSH through the IAP tunnel")
HOST_ALIAS="uni-vm"
# ssh = a Linux host (cloud VM, a Linux box)
# wsl = ssh lands in Windows (PowerShell) on a home server; commands then run inside WSL
HOST_TRANSPORT="ssh"
WSL_DISTRO="Ubuntu-24.04"
WSL_USER=""
# Windows' own OpenSSH client, as Git Bash sees it
SSH_EXE="/c/Windows/System32/OpenSSH/ssh.exe"
# Your framework clone on the laptop (empty = the clone that deploy.sh lives in)
FRAMEWORK_DIR=""
# The framework copy on the host, relative to the host user's home
REMOTE_DIR="uni-os"
# Only if you changed vm.mount_path or vm.drive_remote (empty = the defaults ~/Uni and uni-drive):
# deploy.sh passes them to the host installer (--vault / --remote), which can't read the vault
# config before the vault is mounted.
HOST_VAULT_MOUNT=""
HOST_DRIVE_REMOTE=""
# laptop-ping.ps1 (failover mode only): the Claude desktop app's process and its scheduled-task
# files. These are app internals, not a documented interface: check them after app updates.
APP_PROCESS_LIKE="*\WindowsApps\Claude_*\app\Claude.exe"
APP_TASKS_GLOB="%LOCALAPPDATA%\Claude-Data\*\claude-code-sessions\*\*\scheduled-tasks.json"
