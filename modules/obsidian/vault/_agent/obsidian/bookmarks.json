{
  "_about": "Bookmarks generated by Uni OS from the enabled modules. Merge into .obsidian/bookmarks.json with the framework's modules/obsidian/scripts/merge_obsidian_config.py (dry run first), or add them by hand (right-click a note > Bookmark). Existing bookmarks are never removed; items whose file does not exist are skipped.",
  "items": [
    {"type": "file", "path": "Home.md", "title": "Home"},
{{#if modules.progress}}
    {"type": "file", "path": "progress/current-status.md", "title": "Current status"},
{{/if}}
{{#if modules.planning}}
    {"type": "file", "path": "semester/calendar-and-dates.md", "title": "Dates and deadlines"},
    {"type": "file", "path": "semester/planning-system.md", "title": "Planning system"},
{{/if}}
{{#if modules.courses}}
    {"type": "group", "title": "Courses", "items": [
{{#each courses}}
      {"type": "file", "path": "{{course.folder}}/{{course.slug}}.md", "title": "{{course.short}}"},
{{/each}}
      {"type": "file", "path": "courses-overview.md", "title": "All courses"}
    ]},
{{/if}}
{{#if modules.student-model}}
    {"type": "group", "title": "Me", "items": [
      {"type": "file", "path": "me/profile.md"},
      {"type": "file", "path": "me/weak-spots.md"},
      {"type": "file", "path": "me/learning-style.md"},
{{#if modules.experiments}}
      {"type": "file", "path": "me/habits-experiments.md"},
{{/if}}
      {"type": "file", "path": "me/rhythm-and-habits.md"}
    ]},
{{/if}}
    {"type": "group", "title": "Views", "items": [
      {"type": "file", "path": "views/Courses.base"},
      {"type": "file", "path": "views/Study pages.base"},
      {"type": "file", "path": "views/Weeks.base"},
      {"type": "file", "path": "views/Error logs.base"},
      {"type": "file", "path": "views/Inbox.base"},
      {"type": "file", "path": "views/Recently changed.base"},
      {"type": "file", "path": "views/vault-map.canvas"}
    ]},
    {"type": "file", "path": "_agent/agent-start.md", "title": "For agents"}
  ]
}
