{
  "name": "uni-os-cockpit",
  "version": "0.1.0",
  "private": true,
  "description": "Uni OS cockpit: a calm study dashboard inside Obsidian, read live from the vault's own notes and calendar feeds.",
  "license": "MIT",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
